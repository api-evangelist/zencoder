            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zencoder.com/api/v2/inputs/:input_id",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "Zencoder-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "The number of results to return for each page"
              },
              {
                "name": "input_id",
                "value": "",
                "type": "path",
                "description": "A Zencoder job input id"
              }
            ]
          },
          "docs": "Get job input Details. Job details are available for two months after the job is submitted."
        },
        {
          "info": {
            "name": "Get Input Progress",
            "type": "http"

        {
          "id": "11ef7e70-5d3c-49c2-b0b0-19f5b2cf777b",
          "name": "Get Account Details",
          "request": {
            "name": "Get Account Details",
            "description": {
              "content": "'Account details may be retrieved by issuing an HTTP GET to https://app.zencoder.com/api/v2/account. Account states are `Active`, `Stopped`, `Suspended`, and `Cancelled`. Billing states are `Active`, `Past Due`, and `Cancelled`.'",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "account"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Your API key",
                "key": "Zencoder-Api-Key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

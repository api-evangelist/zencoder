      "item": [
        {
          "id": "f9c68df9-979b-4f1d-b49d-0bbcc0a036bf",
          "name": "Get Usage Report",
          "request": {
            "name": "Get Usage Report",
            "description": {
              "content": "'This report returns a breakdown of video on demand minute usage by day and grouping. It will contain two top-level keys: total and statistics. total will contain the sum of all statistics returned in the report. statistics will contain an entry for each day and grouping. If you do not use the report grouping feature of the API the report will contain only one entry per day. These statistics are collected about once per hour, but there is only one record per day (per grouping). By default this report excludes the current day from the response because it is only partially complete. It is important to note that our service operates in the UTC time zone (including billing periods). All dates and times reported will be in UTC.'",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "vod"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "Start date in the format YYYY-MM-DD (default: 30 days ago)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "End date in the format YYYY-MM-DD (default: today)"
                },
                {
                  "disabled": false,
                  "key": "grouping",
                  "value": "<string>",
                  "description": "A grouping name set in the [Create Job](#operation/createJob) operation"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Your API key",
                "key": "Zencoder-Api-Key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6ed71484-7f06-40fe-88fa-bbcb88f9c23a",
